# Test-environment config.
#
# WHY THIS FILE EXISTS: phpunit.xml pins DB_DATABASE=ogami_test, but that only
# covers `artisan test`. Any `artisan <command> --env=testing` (migrate:fresh,
# db:seed, migrate:rollback, …) loads .env.testing instead — and when this file
# was absent, Laravel silently fell back to .env, whose DB_DATABASE=ogami is the
# DEV database. `migrate:fresh --env=testing` therefore dropped every dev table.
#
# Keep DB_DATABASE=ogami_test here. Never point it at ogami.
APP_NAME="Ogami ERP (testing)"
APP_ENV=testing
APP_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
APP_DEBUG=true
APP_URL=http://localhost

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=ogami_test
DB_USERNAME=ogami
DB_PASSWORD=ogami_dev_pw

# Keep tests off the shared dev infrastructure.
CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=null
MAIL_MAILER=array
BCRYPT_ROUNDS=4
TELESCOPE_ENABLED=false

REDIS_HOST=redis
REDIS_PORT=6379

HASHIDS_SALT=testing_salt_not_for_production
HASHIDS_LENGTH=10
