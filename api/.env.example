APP_NAME="Ogami ERP API"
APP_ENV=local
SEED_DEMO_DATA=false
SEED_REFERENCE_DATA=false
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=
COMPANY_LEGAL_NAME=
COMPANY_ADDRESS=
COMPANY_TIN=
COMPANY_PHONE=
COMPANY_EMAIL=
COMPANY_PUBLIC_URL=
COMPANY_VAT_STATUS=
COMPANY_LOGO_PATH=
COMPANY_CERTIFICATION=
COMPANY_EMPLOYEE_EMAIL_DOMAIN=
COMPANY_SALES_INBOX_EMAIL=
COMPANY_LATITUDE=
COMPANY_LONGITUDE=
QUALITY_COC_MANAGER_NAME=
QUALITY_COC_MANAGER_ROLE=
TAX_PH_VAT_RATE=
ACCOUNTING_FUNCTIONAL_CURRENCY_CODE=
PDF_FOOTER_DISCLAIMER=
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
FRONTEND_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=ogami
DB_USERNAME=ogami
DB_PASSWORD=CHANGEME

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_CLIENT=phpredis

CACHE_STORE=redis
QUEUE_CONNECTION=redis
# Must exceed the longest queued job timeout (currently 1800s).
REDIS_QUEUE_RETRY_AFTER=2400
BROADCAST_CONNECTION=reverb

SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_HTTP_ONLY=true
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SESSION_DOMAIN=

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:80,localhost:3000,localhost:5173,127.0.0.1,127.0.0.1:80

HASHIDS_SALT=change_me_to_a_long_random_string_in_production
HASHIDS_LENGTH=10

# Shared secret for detailed /api/v1/health checks. Empty fails closed; public
# health remains minimal. Detail access requires X-Health-Token (never query).
HEALTH_DETAIL_TOKEN=


REVERB_APP_ID=ogami
REVERB_APP_KEY=CHANGEME
REVERB_APP_SECRET=CHANGEME
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

MAIL_MAILER=smtp
MAIL_HOST=email-smtp.ap-southeast-2.amazonaws.com
MAIL_PORT=587
# SES SMTP username and password from the SES SMTP credentials CSV.
MAIL_USERNAME=your-ses-smtp-username
MAIL_PASSWORD=your-ses-smtp-password
MAIL_SCHEME=smtp
MAIL_FROM_ADDRESS="no-reply@your-verified-domain.example"
MAIL_FROM_NAME="Ogami Philippines"
COMPANY_EMAIL_BRAND_NAME="Ogami Philippines"
