# ─── Ogami ERP — Production PHP image ─────────────────────────────────────
# Multi-stage:
#   1. composer-deps → installs vendor/ with --no-dev
#   2. runtime       → pinned PHP 8.3-FPM, opcache enabled, copies vendor/ + source
#                       (read-only; no host volume mount in prod)
# ──────────────────────────────────────────────────────────────────────────

# Stage 1: Composer dependencies
FROM composer:2 AS deps
WORKDIR /app
COPY api/composer.json api/composer.lock ./
# --ignore-platform-reqs: the composer base image lacks ext-gd/intl/etc; those
# extensions are present in the pinned PHP-FPM runtime stage below, so platform
# checks here are spurious. Deps are resolved against the committed lock file.
RUN composer install \
        --no-dev \
        --no-scripts \
        --prefer-dist \
        --no-progress \
        --no-interaction \
        --optimize-autoloader \
        --ignore-platform-reqs

# Stage 2: Runtime
# Keep the PHP patch and Alpine minor explicit; update this with Dockerfile.
FROM php:8.3.36-fpm-alpine3.24

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

# System deps (subset of dev — no autoconf/g++ needed at runtime)
RUN apk add --no-cache \
        bash \
        git \
        curl \
        ca-certificates \
        openjdk21-jre-headless \
        zip \
        unzip \
        icu \
        libzip \
        libpng \
        libjpeg-turbo \
        freetype \
        oniguruma \
        postgresql-libs \
        postgresql16-client \
        aws-cli \
        # Build deps for ext install (removed after)
        autoconf g++ make linux-headers icu-dev libzip-dev libpng-dev libjpeg-turbo-dev freetype-dev oniguruma-dev postgresql-dev \
    && docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install -j$(nproc) \
        pdo \
        pdo_pgsql \
        pgsql \
        gd \
        zip \
        bcmath \
        intl \
        exif \
        opcache \
        pcntl \
    && pecl install redis \
    && docker-php-ext-enable redis \
    # Strip build deps to keep image small.
    && apk del autoconf g++ make linux-headers icu-dev libzip-dev libpng-dev libjpeg-turbo-dev freetype-dev oniguruma-dev postgresql-dev

# Pin the standalone PDFtk Java build and verify its digest. The wrapper is a
# minimal argv-preserving shim so Symfony Process never interpolates a shell.
RUN mkdir -p /usr/local/lib/pdftk \
    && curl --fail --location --silent --show-error \
        --output /usr/local/lib/pdftk/pdftk-all.jar \
        https://gitlab.com/pdftk-java/pdftk/-/jobs/1527259628/artifacts/raw/build/libs/pdftk-all.jar \
    && echo '2f625bd6e2df0ff8cab0d97bb769746a421879179c25c22646bd8460b5f69b00  /usr/local/lib/pdftk/pdftk-all.jar' | sha256sum -c - \
    && printf '%s\n' '#!/bin/sh' 'exec java -jar /usr/local/lib/pdftk/pdftk-all.jar "$@"' > /usr/local/bin/pdftk \
    && chmod 0755 /usr/local/bin/pdftk \
    && pdftk --version

# OPcache config — tuned for prod.
RUN { \
        echo 'opcache.enable=1'; \
        echo 'opcache.enable_cli=0'; \
        echo 'opcache.memory_consumption=192'; \
        echo 'opcache.interned_strings_buffer=16'; \
        echo 'opcache.max_accelerated_files=20000'; \
        echo 'opcache.validate_timestamps=0'; \
        echo 'opcache.fast_shutdown=1'; \
    } > /usr/local/etc/php/conf.d/opcache.ini \
 && { \
        echo 'memory_limit=256M'; \
        echo 'expose_php=Off'; \
        echo 'display_errors=Off'; \
        echo 'log_errors=On'; \
        echo 'error_log=/var/log/php_errors.log'; \
    } > /usr/local/etc/php/conf.d/zz-prod.ini

# The upstream five-worker limit saturated under a small multi-role burst. The
# dynamic pool can scale to eight while retaining a small idle footprint on the
# target VPS; production operators can lower the ceiling for tighter RAM plans.
RUN sed -i \
        -e 's/^pm.max_children = 5$/pm.max_children = 8/' \
        -e 's/^pm.min_spare_servers = 1$/pm.min_spare_servers = 2/' \
        -e 's/^pm.max_spare_servers = 3$/pm.max_spare_servers = 4/' \
        /usr/local/etc/php-fpm.d/www.conf \
    && grep -q '^pm.max_children = 8$' /usr/local/etc/php-fpm.d/www.conf \
    && grep -q '^pm.min_spare_servers = 2$' /usr/local/etc/php-fpm.d/www.conf \
    && grep -q '^pm.max_spare_servers = 4$' /usr/local/etc/php-fpm.d/www.conf

# Copy app source (api/) and pre-built vendor dir.
COPY docker/php/uploads.ini /usr/local/etc/php/conf.d/zz-uploads.ini

WORKDIR /var/www
COPY api/ /var/www/
COPY --from=deps /app/vendor/ /var/www/vendor/
COPY scripts/db-backup.sh /var/www/scripts/db-backup.sh
COPY scripts/db-restore.sh /var/www/scripts/db-restore.sh
COPY scripts/files-backup.sh /var/www/scripts/files-backup.sh
COPY scripts/files-restore.sh /var/www/scripts/files-restore.sh
COPY docker/php/prod-entrypoint.sh /usr/local/bin/ogami-entrypoint

# Runtime storage is deliberately excluded from the build context: it may
# contain customer documents, bank files, resumes, logs, and local secrets.
RUN mkdir -p \
        storage/app/private \
        storage/framework/cache/data \
        storage/framework/sessions \
        storage/framework/views \
        storage/logs \
        bootstrap/cache \
    # Fail the image build if --ignore-platform-reqs masked a missing runtime
    # extension. Environment-dependent Laravel caches are generated by the
    # entrypoint after real production secrets have been injected.
 && composer check-platform-reqs --no-dev \
 && { pg_dump --version | grep -Eq ' 16\.' \
    || { echo 'ERROR: production image must contain PostgreSQL-16 pg_dump' >&2; exit 1; }; } \
 && pg_dump --version \
 && chmod +x /var/www/scripts/db-backup.sh /var/www/scripts/db-restore.sh \
        /var/www/scripts/files-backup.sh /var/www/scripts/files-restore.sh \
 && chmod +x /usr/local/bin/ogami-entrypoint

# Run as non-root.
RUN addgroup -S www && adduser -S www -G www \
 && chown -R www:www /var/www
USER www

EXPOSE 9000
ENTRYPOINT ["/usr/local/bin/ogami-entrypoint"]
CMD ["php-fpm", "-F"]
