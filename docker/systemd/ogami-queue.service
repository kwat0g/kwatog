[Unit]
Description=OGAMI durable queue worker
After=docker.service
Requires=docker.service

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/home/ec2-user/kwatog
ExecStart=/usr/bin/docker exec ogami-api php artisan queue:work --tries=3 --timeout=1800 --sleep=3 --max-time=3600
ExecStop=/bin/sh -c '/usr/bin/docker exec ogami-api php artisan queue:restart; while kill -0 "$MAINPID" 2>/dev/null; do sleep 1; done'
Restart=always
RestartSec=5
TimeoutStopSec=1810
KillMode=process

[Install]
WantedBy=multi-user.target
