# Copy to .env.e2e with mode 0600, replace every REPLACE_* value, and never commit it.
# scripts/e2e/runner.mjs validates the environment before Docker or Playwright runs.
E2E_ENV=true
E2E_DB_NAME=ogami_e2e
E2E_COMPOSE_PROJECT=ogami-erp-e2e
E2E_BASE_URL=https://127.0.0.1:18443
E2E_HTTP_PORT=18080
E2E_HTTPS_PORT=18443
E2E_MAILPIT_HTTP_PORT=18025
E2E_ACCOUNT_DOMAIN=ogami-e2e.test
E2E_ACCOUNT_PASSWORD=REPLACE_WITH_RANDOM_E2E_ONLY_PASSWORD
E2E_CONTROL_TOKEN=REPLACE_WITH_RANDOM_E2E_ONLY_TOKEN

APP_NAME="Ogami ERP E2E"
APP_ENV=testing
APP_KEY=REPLACE_WITH_RANDOM_LARAVEL_APP_KEY
APP_DEBUG=false
APP_URL=https://nginx
FRONTEND_URL=https://nginx
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# Disposable PH manufacturing company master data required by app policy reads.
COMPANY_VAT_STATUS="VAT Registered"
TAX_PH_VAT_RATE=0.12
ACCOUNTING_FUNCTIONAL_CURRENCY_CODE=PHP

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=ogami_e2e
DB_USERNAME=ogami_e2e
DB_PASSWORD=REPLACE_WITH_RANDOM_E2E_DATABASE_PASSWORD
DB_READER_USERNAME=ogami_e2e_reader
DB_READER_PASSWORD=REPLACE_WITH_RANDOM_E2E_READONLY_PASSWORD

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_BROADCAST_DB=1
REDIS_GENERATION_DB=4
REDIS_CACHE_HOST=redis-cache
CACHE_STORE=redis
CACHE_GENERATION_DRIVER=redis
QUEUE_CONNECTION=redis
REDIS_QUEUE_RETRY_AFTER=3900
REDIS_QUEUE_BLOCK_FOR=1
REDIS_BROADCAST_BLOCK_FOR=1
BROADCAST_CONNECTION=reverb

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_HTTP_ONLY=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=
SANCTUM_STATEFUL_DOMAINS=127.0.0.1:18443,localhost:18443,nginx

REVERB_APP_ID=ogami-e2e
REVERB_APP_KEY=REPLACE_WITH_RANDOM_REVERB_APP_KEY
REVERB_APP_SECRET=REPLACE_WITH_RANDOM_REVERB_APP_SECRET
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_ALLOWED_ORIGINS=nginx

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=
MAIL_FROM_ADDRESS=e2e@ogami-e2e.test
MAIL_FROM_NAME="Ogami E2E"
MAIL_REPLY_TO_ADDRESS=e2e@ogami-e2e.test

SEED_DEMO_DATA=false
SEED_REFERENCE_DATA=true
QC_CHECKLIST_CAPTURE_ENABLED=false
QC_COUNTED_CAPTURE_ENABLED=false
WO_FINISH_FIRST_QC_ENABLED=false
WO_OUTGOING_CONFIRMED_CHECKS_ENABLED=false

VITE_HMR_HOST=nginx
VITE_HMR_PORT=80
VITE_HMR_PROTOCOL=ws
VITE_REVERB_APP_KEY=REPLACE_WITH_RANDOM_REVERB_APP_KEY
VITE_REVERB_HOST=nginx
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https
