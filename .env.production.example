# ─── Ogami ERP — Production environment template ─────────────────────────
# Copy to the repository-root `.env` for docker-compose.prod.yml.
# DO NOT commit `.env` — only this template lives in git.
# Current public domain: ogamiph.dev. Replace it only when changing domains.
# ──────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────
APP_NAME=Ogami ERP
APP_ENV=production
APP_DEBUG=false
# Generate with: docker run --rm composer:2 php -r 'echo "base64:", base64_encode(random_bytes(32)), PHP_EOL;'
APP_KEY=
APP_URL=https://ogamiph.dev
API_GUEST_RATE_LIMIT=60
API_AUTHENTICATED_RATE_LIMIT=300
APP_TIMEZONE=Asia/Manila

# ── Initial administrator ────────────────────────────────────────────────
# AdminUserSeeder reads these three and is reachable ONLY through
# DatabaseSeeder, i.e. `php artisan db:seed --force` in section 6 of
# docs/DEPLOY.md. If any one is blank it warns and returns, the seed still
# exits 0, and the install finishes with ZERO users and no way to log in.
# ADMIN_PASSWORD must be at least 12 characters or the seeder throws.
ADMIN_NAME=System Administrator
# A real mailbox you control.
ADMIN_EMAIL=
# At least 12 characters; generate with: openssl rand -base64 24.
ADMIN_PASSWORD=

# ── Front-end origin (must match APP_URL) ────────────────────────────────
FRONTEND_URL=https://ogamiph.dev
SERVER_NAME=ogamiph.dev

# ── Sanctum SPA cookie auth ──────────────────────────────────────────────
SANCTUM_STATEFUL_DOMAINS=ogamiph.dev,www.ogamiph.dev
# Session/SPA cookie lifetime in minutes (default 14 days).
SANCTUM_EXPIRATION=20160
SESSION_DOMAIN=ogamiph.dev
SESSION_HTTP_ONLY=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_DRIVER=database
SESSION_LIFETIME=30

# ── Database (postgres) ──────────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=ogami
DB_USERNAME=ogami
# Long random — use `openssl rand -hex 32`.
DB_PASSWORD=

# ── Redis (cache, sessions, queues) ──────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_CLIENT=phpredis
CACHE_STORE=redis
QUEUE_CONNECTION=redis
# Must exceed the longest queued job timeout (currently 3600s).
REDIS_QUEUE_RETRY_AFTER=3900
BROADCAST_CONNECTION=reverb

# ── Reverb (WebSocket broadcasting) ──────────────────────────────────────
REVERB_APP_ID=ogami
# Public client key; match VITE_REVERB_APP_KEY below.
REVERB_APP_KEY=
# Long random.
REVERB_APP_SECRET=
REVERB_HOST=ogamiph.dev
REVERB_PORT=443
REVERB_SCHEME=https
# Must exactly match REVERB_APP_KEY; set GitHub production variable too.
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=ogamiph.dev
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https


# ── Mail (Amazon SES Mail Manager authenticated SMTP) ────────────────────
MAIL_MAILER=smtp
MAIL_HOST=7s7miqfkt3xa.uemp.mail-manager-smtp.amazonaws.com
MAIL_PORT=587
# Mail Manager ingress endpoint username.
MAIL_USERNAME=
# Mail Manager SMTP password.
MAIL_PASSWORD=
MAIL_SCHEME=smtp
MAIL_FROM_ADDRESS=donotreply@ogamiph.dev
MAIL_FROM_NAME=Ogami Philippines
COMPANY_EMAIL_BRAND_NAME=Ogami Philippines
EMAIL_FOOTER_DISCLAIMER=

# ── Company identity ─────────────────────────────────────────────────────
# NOT cosmetic. legal_name, address, tin, vat_status, sales_inbox_email and
# employee_email_domain are read with SettingsService::requiredString(), which
# THROWS `Required setting X is missing or invalid` when the value is empty.
#
# Leaving them blank does not disable a feature, it breaks these at run time:
#   • every PDF — PdfService (invoices, statements), PurchaseRequestPdfService
#   • every auth email — welcome, password reset, password-reset link. A user
#     locked out of a blank-configured install cannot recover their account.
#   • 8D complaint reports, daily/weekly production summaries, interview email
#   • GET /api/v1/business-policy (company.vat_status)
#
# And it fails silently at install time: migration 0123 inserts env(KEY, ''), so
# the settings row EXISTS and is empty rather than absent, and SettingsSeeder
# lists these in $deploymentKeys where a blank env value SKIPS the write. Nothing
# warns; the throw arrives the first time someone renders a PDF or resets a
# password.
#
# Compose uses env_file format: raw. Keep values unquoted, including spaces.
# Example: COMPANY_LEGAL_NAME=Philippine Ogami Corporation
COMPANY_LEGAL_NAME=
# Printed on every invoice and PO.
COMPANY_ADDRESS=
# Printed on every invoice — use the real one.
COMPANY_TIN=
COMPANY_PHONE=
COMPANY_EMAIL=
# Base for QR-code self-service URLs.
COMPANY_PUBLIC_URL=
# e.g. VAT Registered.
COMPANY_VAT_STATUS=
# e.g. IATF 16949 — shows on PDF letterheads.
COMPANY_CERTIFICATION=
# Blank is valid; no template renders it.
COMPANY_LOGO_PATH=
# Footer on every generated PDF.
PDF_FOOTER_DISCLAIMER=
# Blank keeps the migration-seeded Philippine default.
TAX_PH_VAT_RATE=
# Blank keeps migration-seeded PHP.
ACCOUNTING_FUNCTIONAL_CURRENCY_CODE=

# These two already carry a migration literal, so a blank value here is safe and
# the row will not be empty: migration 0358 seeds the sales inbox and 0308 the
# employee email domain. Set them only to override.
COMPANY_SALES_INBOX_EMAIL=
COMPANY_EMPLOYEE_EMAIL_DOMAIN=

# Migration 0442 seeds both; blank is safe. Override for a different plant.
COMPANY_LATITUDE=
COMPANY_LONGITUDE=

# Deliberately blank, and should usually stay blank. CoCService falls back to an
# em-dash and "Quality Management"; a name entered here signs every Certificate
# of Conformance the system renders, so it must be a real person who consents.
QUALITY_COC_MANAGER_NAME=
QUALITY_COC_MANAGER_ROLE=

# ── HashIDs (URL ID obfuscation) ───────────────────────────────────────
# Restore old value with an existing DB; generate new only for a fresh DB.
HASHIDS_SALT=
HASHIDS_LENGTH=10
# Required for detailed health checks; use X-Health-Token header only (never query-string).
HEALTH_DETAIL_TOKEN=
# Optional; generate separately from DB_PASSWORD.
BACKUP_RECOVERY_SECRET=

# Keep false in production. Demo/reference data belongs only in disposable environments.
SEED_DEMO_DATA=false
SEED_REFERENCE_DATA=false

# These switches are enabled on the current deployment; keep API, SPA, and
# queue workers on compatible releases before enabling them on a new server.
QC_CHECKLIST_CAPTURE_ENABLED=true
QC_COUNTED_CAPTURE_ENABLED=true
WO_FINISH_FIRST_QC_ENABLED=true
WO_OUTGOING_CONFIRMED_CHECKS_ENABLED=true

# ── Budget control ───────────────────────────────────────────────────────
# warn: allow submission but require Finance acknowledgment at 100%+
# block: reject at 100%+; off: disable budget assessment enforcement
BUDGETING_ENFORCEMENT_MODE=warn

# ── Logging ──────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_LEVEL=warning

# ── Slow-query log (Phase 5b) ────────────────────────────────────────────
# 'true' (default in prod) writes any query >LOG_SLOW_QUERIES_MS to the
# 'slow' channel (storage/logs/slow-queries-{date}.log, 30-day retention).
LOG_SLOW_QUERIES=true
LOG_SLOW_QUERIES_MS=250

# ── Sentry / error tracking (Phase 5b, optional) ────────────────────────
# Leave blank to keep Sentry disabled. To enable, see docs/DEPLOY.md §12.
# SENTRY_LARAVEL_DSN=https://<key>@<org>.ingest.sentry.io/<project-id>
# SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_PROFILES_SAMPLE_RATE=0.1
# SENTRY_RELEASE=

# ── Off-site backup (Phase 5b, optional) ─────────────────────────────────
# Leave blank to keep daily backups local-only. When set, scripts/db-backup.sh
# uploads to the configured destination after the local dump completes.
# BACKUP_S3_BUCKET=s3://ogami-backups
# BACKUP_S3_PREFIX=postgres/
# BACKUP_DIR=/var/www/storage/app/backups
# BACKUP_FILES_DIRECTORY=/var/www/storage/app/private
# BACKUP_FILES_KEEP=30
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=ap-southeast-1
