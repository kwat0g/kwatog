# Never send secrets or runtime data to the Docker daemon/build cache.
**/.env
**/.env.*
!**/.env.example
!**/.env.production.example
api/storage/
api/bootstrap/cache/
backups/
*.log

# Reproducible dependency/build outputs are produced inside their images.
api/vendor/
spa/node_modules/
spa/dist/
spa/playwright-report/
spa/test-results/
node_modules/
coverage/

# Development-only material is not needed by production PHP images.
api/tests/
docs/
api/binding_audit.php
api/call_audit.php
api/database_audit.php
api/import_audit.php
api/model_audit.php
api/perm_audit.php
api/route_audit.php
